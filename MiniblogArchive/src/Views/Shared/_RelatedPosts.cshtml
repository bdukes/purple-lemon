@model IAsyncEnumerable<Post>?

@if (Model != null && (await Model.AnyAsync()))
{
    <aside class="related-posts">
        @await foreach (var post in Model)
        {
            <a href="@post.GetLink()">
                <figure>
                    @post.FindPrimaryImageTag(360, 240)
                    <figcaption>
                        @post.Title
                    </figcaption>
                </figure>
            </a>
        }
    </aside>
}
