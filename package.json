{
	"name": "eleventy-base-blog",
	"version": "9.0.0",
	"description": "A starter repository for a blog web site using the Eleventy site generator.",
	"type": "module",
	"scripts": {
		"build": "concurrently \"npm run build-11ty\" \"npm run build-sass\"",
		"build-11ty": "npx @11ty/eleventy",
		"build-sass": "sass ./css/",
		"start": "concurrently \"npm run start-11ty\" \"npm run start-sass\"",
		"start-11ty": "npm run build-11ty -- --serve --quiet",
		"start-sass": "npm run build-sass -- --watch",
		"debug": "cross-env DEBUG=Eleventy* npx @11ty/eleventy",
		"debugstart": "cross-env DEBUG=Eleventy* npx @11ty/eleventy --serve --quiet",
		"benchmark": "cross-env DEBUG=Eleventy:Benchmark* npx @11ty/eleventy"
	},
	"repository": {
		"type": "git",
		"url": "git://github.com/11ty/eleventy-base-blog.git"
	},
	"author": "Zach Leatherman (https://zachleat.com/)",
	"license": "MIT",
	"engines": {
		"node": ">=18"
	},
	"funding": {
		"type": "opencollective",
		"url": "https://opencollective.com/11ty"
	},
	"bugs": {
		"url": "https://github.com/11ty/eleventy-base-blog/issues"
	},
	"homepage": "https://github.com/11ty/eleventy-base-blog#readme",
	"devDependencies": {
		"@11ty/eleventy": "^3.1.6",
		"@11ty/eleventy-img": "^7.0.0",
		"@11ty/eleventy-navigation": "^1.0.5",
		"@11ty/eleventy-plugin-rss": "^3.0.0",
		"@11ty/eleventy-plugin-syntaxhighlight": "^5.0.2",
		"@xmldom/xmldom": "^0.9.12",
		"concurrently": "^10.0.6",
		"cross-env": "^10.1.0",
		"luxon": "^3.7.2",
		"sass": "^1.105.1",
		"zod": "^4.4.3"
	},
	"devEngines": {
		"runtime": {
			"name": "node",
			"onFail": "download",
			"version": "^26.11.1"
		},
		"packageManager": {
			"name": "npm",
			"onFail": "download"
		}
	}
}
