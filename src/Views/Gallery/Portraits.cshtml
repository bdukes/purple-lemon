@{
    ViewData["Title"] = "Headshots from Purple Lemon Photography";
    ViewData["Description"] = $"View headshot and senior photos from Nikki Dukes of Purple Lemon Photography";
}

@section head {
    <link rel="stylesheet" href="~/css/gallery.scss" />
}

    <div class="main-content gallery gallery__headshots">
        <h1>Headshots</h1>

        <img src="https://res.cloudinary.com/purple-lemon-photography/image/upload/q_auto,fl_lossy.keep_attribution,f_auto/Portraits/Antionette-13" class="image__tall" height="1000" width="664" alt="Professional African American Woman in Non for Profit head shot in Forest Park" />
        <img src="https://res.cloudinary.com/purple-lemon-photography/image/upload/q_auto,fl_lossy.keep_attribution,f_auto/Portraits/Janele_Dance_Headshots-89" class="image__tall" height="1000" width="664" alt="Active Professional Dancer in urban cityscape in St. Louis" />
        <img src="https://res.cloudinary.com/purple-lemon-photography/image/upload/q_auto,fl_lossy.keep_attribution,f_auto/Portraits/Harold-8" class="image__tall" height="1000" width="664" alt="African American Male Actor Head shot in West County, St. Louis" />
        <img src="https://res.cloudinary.com/purple-lemon-photography/image/upload/q_auto,fl_lossy.keep_attribution,f_auto/Portraits/Kristen-82" class="image__tall" height="1000" width="664" alt="Senior girl near Tower Grove or Botanical Gardens in St. Louis" />

        <img src="https://res.cloudinary.com/purple-lemon-photography/image/upload/q_auto,fl_lossy.keep_attribution,f_auto/Portraits/Sara_Dance-021" class="image__wide" height="664" width="1000" alt="Professional Dancer in Studio in St. Louis in high key" />
        <img src="https://res.cloudinary.com/purple-lemon-photography/image/upload/q_auto,fl_lossy.keep_attribution,f_auto/Portraits/Kristen-20" class="image__wide" height="664" width="1000" alt="Senior girl photographed on windy day near Union Station, St. Louis" />
        <img src="https://res.cloudinary.com/purple-lemon-photography/image/upload/q_auto,fl_lossy.keep_attribution,f_auto/Portraits/Overkamp_CF-001" class="image__wide" height="664" width="1000" alt="Professional graphic designer headshot photograph" />
        <img src="https://res.cloudinary.com/purple-lemon-photography/image/upload/q_auto,fl_lossy.keep_attribution,f_auto/Portraits/Aubrey-72" class="image__wide" height="664" width="1000" alt="Urban senior portrait in St. Louis with brick" />

        <img src="https://res.cloudinary.com/purple-lemon-photography/image/upload/q_auto,fl_lossy.keep_attribution,f_auto/Portraits/Rachel_Saddler-054" class="image__tall" height="1000" width="664" alt="African American woman laughing in studio indoors in St. Louis" />
