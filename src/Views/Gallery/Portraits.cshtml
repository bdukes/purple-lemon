@{
    ViewData["Title"] = "Headshots from Purple Lemon Photography";
    ViewData["Description"] = $"View headshot and senior photos from Nikki Dukes of Purple Lemon Photography";
}

@section head {
    <link rel="stylesheet" href="~/css/gallery.scss" />
}

    <div class="gallery gallery__headshots">
        <h1>Headshots</h1>

        <img src='~/img/Headshots/Antionette-13.jpg' class='image__tall' height='1000' width='664' />
        <img src='~/img/Headshots/Janele Dance Headshots-89.jpg' class='image__tall' height='1000' width='664' />
        <img src='~/img/Headshots/Harold-8.jpg' class='image__tall' height='1000' width='664' />
        <img src='~/img/Headshots/Kristen-82.jpg' class='image__tall' height='1000' width='664' />

        <img src='~/img/Headshots/Sara Dance-021.jpg' class='image__wide' height='664' width='1000' />
        <img src='~/img/Headshots/Kristen-20.jpg' class='image__wide' height='664' width='1000' />
        <img src='~/img/Headshots/Overkamp CF-001.jpg' class='image__wide' height='664' width='1000' />
        <img src='~/img/Headshots/Aubrey-72.jpg' class='image__wide' height='664' width='1000' />

        <img src='~/img/Headshots/Rachel Saddler-054.jpg' class='image__tall' height='1000' width='664' />
        <img src='~/img/Headshots/Sara Campbell-017.jpg' class='image__tall' height='1000' width='664' />
        <img src='~/img/Headshots/_DSC0389.jpg' class='image__tall' height='1000' width='664' />
        <img src='~/img/Headshots/JaDora-033.jpg' class='image__tall' height='1000' width='664' />
        
        <img src='~/img/Headshots/Christy-006.jpg' class='image__tall' height='1000' width='664' />
        <img src='~/img/Headshots/Ryan Lane-021.jpg' class='image__tall' height='1000' width='664' />
        <img src='~/img/Headshots/Sam Campbell-014.jpg' class='image__tall' height='1000' width='664' />
        <img src='~/img/Headshots/_DSC0676.jpg' class='image__tall' height='1000' width='664' />

        <img src='~/img/Headshots/Ryan Lane-053.jpg' class='image__wide' height='664' width='1000' />
        <img src='~/img/Headshots/Aubrey-20.jpg' class='image__wide' height='664' width='1000' />
        <img src='~/img/Headshots/Sami & Zach-76.jpg' class='image__wide' height='664' width='1000' />
        <img src='~/img/Headshots/Overkamp CF-012.jpg' class='image__wide' height='664' width='1000' />

        <aside>
            <ul>
                <li>
                    View the family gallery
                    <a class="action__primary" asp-controller="Gallery" asp-action="Families"><span>See</span><span>More</span></a>
                </li>
                <li>
                    Read the blog
                    <a class="action__primary" asp-controller="Blog" asp-action="Index"><span>Read</span><span>More</span></a>
                </li>
                <li>
                    Get started
                    <a class="action__primary" asp-controller="Contact" asp-action="Index"><span>Contact</span><span>Us</span></a>
                </li>
            </ul>
        </aside>

        <nav class="nav__end">
            @{
                await Html.RenderPartialAsync("_Menu");
            }
        </nav>
    </div>
