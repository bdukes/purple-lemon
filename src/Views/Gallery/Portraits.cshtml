        <img src="https://res.cloudinary.com/purple-lemon-photography/image/upload/q_auto,fl_lossy.keep_attribution,f_auto/Portraits/Sam_Campbell-014" class="image__tall" height="1000" width="664" alt="High School Male senior picture with guitar on trail in West County, St. Louis" />
        <img src="https://res.cloudinary.com/purple-lemon-photography/image/upload/q_auto,fl_lossy.keep_attribution,f_auto/Portraits/_DSC0676" class="image__tall" height="1000" width="664" alt="Pastor head shot in St. Louis" />

        <img src="https://res.cloudinary.com/purple-lemon-photography/image/upload/q_auto,fl_lossy.keep_attribution,f_auto/Portraits/Ryan_Lane-053" class="image__wide" height="664" width="1000" alt="High School Senior Boy with soccer jersey portrait on overpass with blue sky in North County St. Louis" />
        <img src="https://res.cloudinary.com/purple-lemon-photography/image/upload/q_auto,fl_lossy.keep_attribution,f_auto/Portraits/Aubrey-20" class="image__wide" height="664" width="1000" alt="Smiling high school senior girl outdoors in St. Louis" />
        <img src="https://res.cloudinary.com/purple-lemon-photography/image/upload/q_auto,fl_lossy.keep_attribution,f_auto/Portraits/Sami_Zach-76" class="image__wide" height="664" width="1000" alt="High School Boy in cafeteria in West County St. Louis with chairs" />
        <img src="https://res.cloudinary.com/purple-lemon-photography/image/upload/q_auto,fl_lossy.keep_attribution,f_auto/Portraits/Overkamp_CF-012" class="image__wide" height="664" width="1000" alt="Portrait of a website graphic designer with gauged ears and boufant hair" />

        <aside>
            <ul>
                <li>
                    View the family gallery
                    <a class="action__primary" asp-controller="Gallery" asp-action="Family"><span>See</span><span>More</span></a>
                </li>
                <li>
                    Read the blog
                    <a class="action__primary" asp-controller="Blog" asp-action="Index"><span>Read</span><span>More</span></a>
                </li>
                <li>
                    Get started
                    <a class="action__primary" asp-controller="Contact" asp-action="Index"><span>Contact</span><span>Us</span></a>
                </li>
            </ul>
        </aside>

        <nav class="nav__end">
            @{
                await Html.RenderPartialAsync("_Menu");
            }
        </nav>
    </div>
