@{
    ViewData["Title"] = "Contact Purple Lemon Photography";
    ViewData["Description"] = $"How to schedule a consultation with Nikki Dukes, St. Louis wedding photographer";
}

@section head {
    <link rel="stylesheet" href="~/css/contact.scss" />
}

<div class="contact">
    <section class="personal">
        <h2>Nikki</h2>
        <h3>Booking, package information, general inquiries</h3>
        <img src="https://res.cloudinary.com/purple-lemon-photography/image/upload/f_auto/v1/nikki_lemon" alt="Photo collage of Nikki eating lemons" />
        <a href="mailto:nikki@purplelemonphotography.com">nikki@purplelemonphotography.com</a>
    </section>
    <section class="personal">
        <h2>Brian</h2>
        <h3>Billing, galleries, and website inquiries</h3>
        <img src="https://res.cloudinary.com/purple-lemon-photography/image/upload/f_auto/v1/brian_lemon" alt="Photo collage of Brian eating lemons" />
        <a href="mailto:brian@purplelemonphotography.com">brian@purplelemonphotography.com</a>
    </section>

    <section class="general-info">
        <div>
            <address>
                8703 David Ave<br />
                St. Louis, MO<br />
                63114
            </address>
        </div>
        <div><a href="tel:+13148531934">314-853-1934</a></div>
        <div>Hours: availability changes seasonally, by appointment only</div>
    </section>

    <nav class="nav__end">
        @{
            await Html.RenderPartialAsync("_Menu");
        }
    </nav>
</div>
