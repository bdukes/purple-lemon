---
layout: layouts/base.njk
---
{#- <link rel="canonical" href="@(host + Model.GetLink())" /> #}
<style>{% include "css/blog.css" %}</style>

<article class="post container main-content post__full" itemscope itemtype="http://schema.org/BlogPosting" itemprop="blogPost">
	<header>
		<h1 itemprop="name headline"><a href="{{ page.url }}" rel="canonical" itemprop="url">{{ title }}</a></h1>
		<time datetime="{{ pubDate | htmlDateString }}" itemprop="datePublished">Published {{ pubDate | log | readableDate }}</time>
	</header>
	<div itemprop="articleBody mainEntityOfPage" cdnify>
		{{ content | safe }}
	</div>
	<footer>
		<ul class="categories">
			{%- for tag in tags | filterTagList %}
				{%- set tagUrl %}/blog/category/{{ tag | slugify }}/{% endset %}
				<li itemprop="articleSection"><a href="{{ tagUrl }}">{{ tag }}</a></li>
			{%- endfor %}
		</ul>

		<meta itemprop="author" content="{{ owner }}" />
		<meta itemprop="dateModified" content="{{ lastModified | htmlDateString }}" />
		<meta itemprop="mainEntityOfPage" content="{{ page.url }}" />
	</footer>
</article>

{% set postslist = getRelatedPosts(collections, tags, page.filePathStem) %}
{% include "related-posts.njk" %}
